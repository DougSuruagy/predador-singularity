//@version=6
strategy("PREDATOR v9.0 | ASTRAL CLOUD", overlay=true, margin_long=100, margin_short=100)

// --- INPUTS ---
src = close
len = input.int(14, "Neural Sensitivity")
mult = input.float(2.0, "Volatility Multiplier")

// --- LÓGICA DE RENDIMENTO (SCALPER) ---
basis = ta.sma(src, len)
dev = mult * ta.stdev(src, len)
upper = basis + dev
lower = basis - dev

buy_signal = ta.crossunder(src, lower)
sell_signal = ta.crossover(src, upper)

// --- ESTOQUE ZERO (Day Trade Puro) ---
is_market_open = (hour >= 9 and hour < 17) or (hour == 17 and minute < 30)
can_trade = is_market_open

if (buy_signal and can_trade)
    strategy.entry("Buy", strategy.long, comment="REPASSE_SKYNET")
    // Enviar para o Render
    alert("{\"action\": \"BUY\", \"symbol\": \"WING26\", \"price\": " + str.tostring(close) + "}", alert.freq_once_per_bar)

if (sell_signal and can_trade)
    strategy.entry("Sell", strategy.short, comment="REPASSE_SKYNET")
    // Enviar para o Render
    alert("{\"action\": \"SELL\", \"symbol\": \"WING26\", \"price\": " + str.tostring(close) + "}", alert.freq_once_per_bar)

// Fecha tudo às 17:45 (ESTOQUE ZERO)
if (hour == 17 and minute == 45)
    strategy.close_all(comment="FORCE_ZERO_STOCK")
