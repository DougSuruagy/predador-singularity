# 🐋 POLYMARKET SNIPER - CREDENCIAIS SOBERANAS
# NUNCA COMPARTILHE ESTE ARQUIVO

# 🔗 BLOCKCHAIN CONFIG
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/SUA_CHAVE_AQUI
PRIVATE_KEY=0x_SUA_CHAVE_PRIVADA_DA_CARTEIRA_AQUI
WALLET_ADDRESS=0x_ENDERECO_PUBLICO_DA_SUA_CARTEIRA  # O "Funder" address
SIGNATURE_TYPE=0  # 0 para MetaMask/EOA, 1 para Email/Magic

# 📊 POLYMARKET CLOB API (Profile > Settings > API Keys)
POLY_API_KEY=sua_api_key
POLY_API_SECRET=seu_api_secret
POLY_API_PASSPHRASE=sua_passphrase

# 🐋 WHALE RADAR CONFIG
# Lista de endereços de baleias separados por vírgula
WHALE_ADDRESSES=0x0000000000,0x1111111111

# 🛡️ RISK MANAGEMENT
MAX_BET_USDC=10.0
SLIPPAGE_TOLERANCE=0.01  # 1%
DEFAULT_COPY_RATIO=1.0  # 1.0 = Copia o mesmo valor proporcional, 0.5 = Metade
